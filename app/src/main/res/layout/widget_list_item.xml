<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical"
    android:background="@android:color/transparent">

    <!-- App Icon -->
    <ImageView
        android:id="@+id/app_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="10dp"
        android:scaleType="fitCenter"
        tools:src="@drawable/ic_shappky" />

    <!-- App Name and Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:ellipsize="end"
            android:singleLine="true"
            tools:text="Application Name" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/app_type_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="4dp"
                android:tint="#80FFFFFF"
                android:visibility="gone"
                tools:src="@drawable/ic_person_outlined"
                tools:ignore="UseAppTint" />

            <TextView
                android:id="@+id/app_package"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A0FFFFFF"
                android:textSize="11sp"
                android:ellipsize="end"
                android:singleLine="true"
                tools:text="com.example.app" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/app_cpu_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/memory"
                android:tint="#A0FFFFFF"
                tools:ignore="UseAppTint" />

            <TextView
                android:id="@+id/app_cpu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A0FFFFFF"
                android:textSize="11sp"
                tools:text="5.2%" />

            <ImageView
                android:id="@+id/app_ram_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/memory_alt"
                android:tint="#A0FFFFFF"
                tools:ignore="UseAppTint" />

            <TextView
                android:id="@+id/app_ram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A0FFFFFF"
                android:textSize="11sp"
                tools:text="45.2 MB" />
        </LinearLayout>
    </LinearLayout>

    <!-- Close Button -->
    <ImageButton
        android:id="@+id/btn_close_app"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_cancel_outlined"
        android:tint="#ECEFF1"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="Close App"
        tools:ignore="UseAppTint" />

</LinearLayout>
